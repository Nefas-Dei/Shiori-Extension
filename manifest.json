{
    "manifest_version": 3,
    "name": "Shiori Reading Sync",
    "version": "0.1.0",
    "description": "Sync exact chapter and scroll progress from novel sites to your self-hosted Shiori sync server.",
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "action": {
        "default_title": "Shiori Reading Sync",
        "default_popup": "src/popup.html"
    },
    "options_ui": {
        "page": "src/options.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "src/lib/shared.js",
                "src/content.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "icons": {
        "16": "src/icons/icon16.png",
        "32": "src/icons/icon32.png",
        "48": "src/icons/icon48.png",
        "128": "src/icons/icon128.png"
    }
}
